# Supabase > Project Settings > Database > Connection string (URI).
# Use the session pooler/5432 for this Node.js pg.Pool connection.
DATABASE_URL=postgresql://postgres.aiobavotskgvqnspdjrj:Ticketu-notificaciones@aws-0-us-east-2.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000

PORT=3000
AUTH_SERVICE_URL=http://127.0.0.1:10000
AUTH_TIMEOUT_MS=5000
FRONTEND_ORIGIN=http://localhost:3000

BROKER_MODE=rabbitmq
BROKER_URL=amqp://ticketu:ticketu_dev@localhost:5672/ticketu

# Gmail: crea una contrasena de aplicacion en la cuenta remitente.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER= #correo al que llega 
SMTP_PASS=#contraseña dada en la verificacion de dos pasos 
SMTP_FROM= #correo que envia (pueden ser iguales)

# Copiar aqui el mismo valor que auth/backend/.env -> INTERNAL_API_KEY
AUTH_INTERNAL_API_KEY=

PANEL_EVENT_EXCHANGES=ticketu.events,panel.evento.notificaciones.v1
PANEL_EVENT_ROUTING_KEY=panel.evento.notificaciones.v1
PANEL_EVENT_QUEUE=notificaciones.panel_eventos.v1
