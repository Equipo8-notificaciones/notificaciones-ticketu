# Copy to .env and fill in real values. Do not commit .env.

# Supabase
DATABASE_URL=postgresql://<USUARIO>:<CONTRASEÑA>@<HOST>:5432/postgres
DB_SSL=true
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000

# Server
PORT=3000
AUTH_SERVICE_URL=http://auth-service:10000
AUTH_TIMEOUT_MS=5000
FRONTEND_ORIGIN=http://localhost:3000
NOTIFICACIONES_URL=http://localhost:3001

# RabbitMQ
BROKER_MODE=rabbitmq
RABBITMQ_USER=<USUARIO>
RABBITMQ_PASSWORD=<CONTRASEÑA>
BROKER_URL=amqp://<USUARIO>:<CONTRASEÑA>@localhost:5672/ticketu

# Gmail - SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<CORREO_REMITENTE>
SMTP_PASS=<CONTRASEÑA_DE_APLICACION>
SMTP_FROM=<CORREO_REMITENTE>

# Test email (optional)
TEST_EMAIL_DESTINO=<CORREO_DE_PRUEBA>
