# Copiar este archivo a .env y completar con los valores reales.
# No subir .env ni sus contraseñas o claves al repositorio.

# PostgreSQL / Supabase
# Supabase: Dashboard > Project Settings > Database > Connection string (URI).
# Reemplazar usuario, contrasena, host y base por los datos del entorno.
DATABASE_URL=postgresql://usuario_ejemplo:contrasena_ejemplo@localhost:5432/notificaciones
# false para PostgreSQL local; configurar SSL segun el proveedor remoto.
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000

# Servidor y autenticacion
PORT=3000
AUTH_SERVICE_URL=http://auth-service:10000
AUTH_TIMEOUT_MS=5000
INTERNAL_API_KEY=CAMBIAR_CLAVE_COMPARTIDA_SEGURA
AUTH_INTERNAL_API_KEY=REEMPLAZAR_POR_CLAVE_COMPARTIDA_CON_AUTH
FRONTEND_ORIGIN=http://localhost:3000
NOTIFICACIONES_URL=http://localhost:3001

# Eventos del Panel
PANEL_EVENT_EXCHANGES=ticketu.events,panel.evento.notificaciones.v1
PANEL_EVENT_ROUTING_KEY=panel.evento.notificaciones.v1
PANEL_EVENT_QUEUE=notificaciones.panel_eventos.v1

# RabbitMQ
# Los ejemplos siguientes deben usar la misma contrasena que RABBITMQ_PASSWORD.
BROKER_MODE=rabbitmq
RABBITMQ_USER=ticketu
RABBITMQ_PASSWORD=REEMPLAZAR_CONTRASENA_RABBITMQ
BROKER_URL=amqp://ticketu:REEMPLAZAR_CONTRASENA_RABBITMQ@localhost:5672/ticketu
BROKER_URL_DOCKER=amqp://ticketu:REEMPLAZAR_CONTRASENA_RABBITMQ@ticketu-rabbitmq:5672/ticketu

# Gmail / SMTP
# Crear una contrasena de aplicacion en la cuenta remitente (si aplica).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Direccion de correo que envia mensajes.
SMTP_USER=remitente@example.com
# Contrasena de aplicacion del correo remitente; no es la contrasena habitual.
SMTP_PASS=REEMPLAZAR_CONTRASENA_DE_APLICACION
# Correo remitente (puede coincidir con SMTP_USER).
SMTP_FROM=remitente@example.com

# Opcional: destinatario para pruebas de compra.
# Utilizar un buzon de pruebas controlado por el equipo.
TEST_EMAIL_DESTINO=prueba@example.com
