    {
      "name": "03 · Validaciones de autenticación",
      "item": [
        {
          "name": "Sin cookie de sesión (espera 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "otra_cookie=sin_token",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notificaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notificaciones"
              ]
            },
            "description": "Prueba el middleware de autenticación enviando una cookie que no contiene jwt_token. Se espera HTTP 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401 sin sesión\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
