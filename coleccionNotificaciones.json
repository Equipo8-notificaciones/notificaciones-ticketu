{
  "info": {
    "_postman_id": "643f667c-8b2d-4e6e-9969-227129a67e96",
    "name": "TicketU · Microservicio Notificaciones",
    "description": "Colección de pruebas de la API de Notificaciones. Endpoints basados en backend/app.js y backend/src/routes/notificacionRoutes.js. Las rutas protegidas requieren una cookie de sesión válida emitida por Auth. Para ejecutar las pruebas de punta a punta, configura jwtToken en el entorno Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 · Salud y documentación",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifica que el backend de Notificaciones esté respondiendo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"El servicio informa estado OK\", function () { const body = pm.response.json(); pm.expect(body.servicio).to.eql(\"notificaciones\"); pm.expect(body.estado).to.eql(\"OK\"); });"
                ]
              }
            }
          ]
        },
