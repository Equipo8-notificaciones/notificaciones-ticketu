    {
      "name": "02 · Notificaciones (requiere sesión Auth)",
      "item": [
        {
          "name": "Crear notificación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "jwt_token={{jwtToken}}",
                "type": "text",
                "description": "La sesión de Auth debe ser válida. jwtToken contiene solo el valor del token, sin el prefijo jwt_token=."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notificaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notificaciones"
              ]
            },
            "description": "Crea una notificación para el usuario autenticado. El servidor toma el ID de usuario de la sesión; no necesitas enviar usuarioId/id_usuario.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"COMPRA\",\n  \"mensaje\": \"Prueba Postman: compra confirmada.\",\n  \"datos\": {\n    \"origen\": \"postman\",\n    \"eventoId\": \"evt-demo-001\",\n    \"entradaId\": \"entrada-demo-001\"\n  },\n  \"canal\": \"APP\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 - notificación creada\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"La respuesta contiene el ID de notificación\", function () { const body = pm.response.json(); pm.expect(body).to.have.property(\"id_notificacion\"); pm.environment.set(\"notificationId\", String(body.id_notificacion)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar centro de notificaciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "jwt_token={{jwtToken}}",
                "type": "text",
                "description": "La sesión de Auth debe ser válida. jwtToken contiene solo el valor del token, sin el prefijo jwt_token=."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notificaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notificaciones"
              ]
            },
            "description": "Lista las notificaciones no eliminadas del usuario de la sesión."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"La respuesta es una lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
